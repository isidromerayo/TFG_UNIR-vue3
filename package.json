{
  "name": "frontend-vue",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test-headless": "vitest run",
    "test-headless-cc": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component",
    "cypress:component:open": "cypress open --component",
    "cypress:component:coverage": "CYPRESS_COVERAGE=true cypress run --component && npx nyc report --reporter=lcov --reporter=text-summary",
    "cypress:component:coverage:open": "CYPRESS_COVERAGE=true cypress open --component",
    "cypress:e2e": "cypress run --e2e",
    "cypress:e2e:coverage": "CYPRESS_COVERAGE=true cypress run --e2e",
    "coverage:merge": "mkdir -p coverage/merged && npx lcov-result-merger 'coverage/**/lcov.info' coverage/merged/lcov.info",
    "coverage:verify": "node scripts/verify-coverage.cjs",
    "test:all": "pnpm test-headless && pnpm cypress:component",
    "test:all:ci": "pnpm test:coverage && pnpm cypress:component:coverage",
    "coverage:report": "echo 'Coverage report generated at coverage/index.html'",
    "security": "./scripts/security-check.sh",
    "security:audit": "pnpm audit",
    "security:outdated": "pnpm outdated"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/vue": "^6.0.3",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@pinia/testing": "^1.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.6.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vitest/ui": "^4.1.5",
    "@vue/compiler-sfc": "^3.5.33",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.8.1",
    "axios": "^1.18.0",
    "cypress": "^15.14.2",
    "eslint": "^10.9.1",
    "eslint-plugin-cypress": "7.0.1",
    "eslint-plugin-vue": "~10.10.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "lcov-result-merger": "^5.0.1",
    "npm-run-all2": "^8.0.4",
    "nyc": "^17.1.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-istanbul": "^6.0.2",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vitest": "^4.1.5",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.7",
    "yup": "^1.7.1"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.15.2",
      "js-yaml": "^4.3.1",
      "nanoid@<3.3.17": "^3.3.17",
      "lodash": "^4.17.23",
      "shell-quote": ">=1.9.0",
      "postcss": ">=8.5.18",
      "ws": ">=8.21.0",
      "uuid": ">=11.1.1",
      "fast-uri": ">=4.1.2",
      "form-data": ">=4.0.6",
      "js-cookie": ">=3.0.7",
      "systeminformation": ">=5.31.7",
      "tmp": ">=0.2.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@babel/core": ">=7.29.6",
      "yaml": ">=2.8.3",
      "esbuild": ">=0.28.1"
    }
  }
}
